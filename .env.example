# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "sqlite" for zero-setup local development, "postgresql" for
# staging/production (required — matches the shared-database architecture).
DATABASE_ENGINE=sqlite

# Used only when DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Used only when DATABASE_ENGINE=postgresql
POSTGRES_DB=a2z_icsem
POSTGRES_USER=a2z_icsem
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Field-level encryption (restricted PII / credential secure_details)
FIELD_ENCRYPTION_KEY=
